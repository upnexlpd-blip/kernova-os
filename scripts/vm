#!/usr/bin/env python3
"""Create a disposable KERNOVA guest or boot it on a graphical Debian builder."""
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
DISK_SIZE = 40 * 1024**3
MODES = ("bios", "uefi", "secure")


def regular(path):
    if path.is_symlink() or not path.is_file():
        raise ValueError(f"Expected a regular file: {path}")
    return path


def guest_dir(name):
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,47}", name):
        raise ValueError("Use a guest name of 1–48 lowercase letters, digits or hyphens.")
    path = ROOT / "build" / "vms" / name
    if path.resolve() != path:
        raise ValueError(f"Refusing redirected guest storage: {path}")
    return path


def select_firmware(descriptors, mode):
    for descriptor in sorted(descriptors):
        data = json.loads(descriptor.read_text())
        features = data.get("features", [])
        mapping = data["mapping"]
        targets = data.get("targets", [])
        if not any(t["architecture"] == "x86_64" and
                   any("q35" in pattern for pattern in t["machines"]) for t in targets):
            continue
        if "uefi" not in data["interface-types"] or mapping["device"] != "flash":
            continue
        secure = "secure-boot" in features
        if (mode == "secure") != secure or secure and "enrolled-keys" not in features:
            continue
        code, nvram = mapping["executable"], mapping["nvram-template"]
        if code["format"] == nvram["format"] == "raw":
            return descriptor, Path(code["filename"]), Path(nvram["filename"])
    raise ValueError(f"No matching packaged x86_64 Q35 OVMF descriptor for {mode}.")


def firmware(mode):
    listing = subprocess.check_output(["dpkg-query", "-L", "ovmf"], text=True)
    descriptors = [Path(p) for p in listing.splitlines()
                   if p.startswith("/usr/share/qemu/firmware/") and p.endswith(".json")]
    return select_firmware(descriptors, mode)


def create(name, mode):
    path = guest_dir(name)
    fw = firmware(mode) if mode != "bios" else None
    path.mkdir(parents=True, exist_ok=False, mode=0o700)
    if fw:
        descriptor, _, template = fw
        shutil.copyfile(template, path / "nvram.fd")
    with (path / "disk.raw").open("xb") as disk:
        disk.truncate(DISK_SIZE)
    state = {"firmware": mode, "descriptor": descriptor.name if fw else None}
    (path / "guest.json").write_text(json.dumps(state, indent=2) + "\n")
    print(f"Created {name}: one new 40 GiB sparse disk at {path / 'disk.raw'}")


def drive_path(path):
    # QEMU key/value option syntax escapes a literal comma with another comma.
    return str(path).replace(",", ",,")


def command(name, media):
    path = guest_dir(name)
    disk = regular(path / "disk.raw")
    if disk.stat().st_size != DISK_SIZE:
        raise ValueError(f"Unexpected size for KERNOVA test disk: {disk}")
    state = json.loads(regular(path / "guest.json").read_text())
    mode = state["firmware"]
    if mode not in MODES:
        raise ValueError(f"Unknown firmware mode: {mode}")
    accel = "kvm" if os.access("/dev/kvm", os.R_OK | os.W_OK) else "tcg"
    print(f"Guest {name}, firmware {mode}, acceleration {accel}, disk {disk}", flush=True)
    args = ["qemu-system-x86_64", "-name", f"KERNOVA-{name}", "-nodefaults",
            "-machine", "q35,smm=on" if mode == "secure" else "q35", "-accel", accel,
            "-cpu", "host" if accel == "kvm" else "max", "-smp", "2", "-m", "3584",
            "-display", "gtk", "-device", "virtio-vga", "-device", "qemu-xhci",
            "-device", "usb-tablet", "-device", "usb-kbd",
            "-nic", "user,model=virtio-net-pci", "-audiodev", "pa,id=sound",
            "-device", "intel-hda", "-device", "hda-duplex,audiodev=sound",
            "-drive", f"if=none,id=osdisk,format=raw,file={drive_path(disk)}",
            "-device", "virtio-blk-pci,drive=osdisk,serial=KERNOVA-TEST,bootindex=2"]
    if mode != "bios":
        descriptor, code, _ = firmware(mode)
        if descriptor.name != state["descriptor"]:
            raise ValueError("OVMF descriptor changed since VM creation. Review the firmware update.")
        nvram = regular(path / "nvram.fd")
        if mode == "secure":
            args += ["-global", "driver=cfi.pflash01,property=secure,value=on"]
        args += ["-drive", f"if=pflash,unit=0,format=raw,readonly=on,file={drive_path(code)}",
                 "-drive", f"if=pflash,unit=1,format=raw,file={drive_path(nvram)}"]
    if media is not None:
        iso = regular(Path(media).absolute())
        if iso.suffix.lower() != ".iso":
            raise ValueError("Installation media must be an ISO file.")
        args += ["-drive", f"if=none,id=cd,media=cdrom,readonly=on,format=raw,file={drive_path(iso)}",
                 "-device", "ide-cd,drive=cd,bootindex=1"]
    return args


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_subparsers(dest="action", required=True)
    new = modes.add_parser("create", help="allocate a new guest and private NVRAM")
    new.add_argument("name")
    new.add_argument("--firmware", choices=MODES, default="uefi")
    media = modes.add_parser("media", help="boot live/installer ISO with the test disk")
    media.add_argument("name")
    media.add_argument("iso")
    modes.add_parser("boot", help="boot only the test disk").add_argument("name")
    a = parser.parse_args()
    if sys.platform != "linux" or os.geteuid() == 0:
        parser.exit(2, "Run as an ordinary user on the graphical Debian build/test machine.\n")
    os.umask(0o077)
    if a.action == "create":
        create(a.name, a.firmware)
        return 0
    return subprocess.run(command(a.name, getattr(a, "iso", None)), check=False).returncode


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (KeyError, OSError, ValueError, subprocess.SubprocessError) as error:
        sys.exit(f"VM operation failed: {error}")
