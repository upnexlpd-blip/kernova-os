// Prefer the package copies assembled for this ISO when their public versions match.
// live-build removes both this setting and its companion list from the final root.
APT::Update::Pre-Invoke {"if test -s /etc/apt/sources.list.d/packages.list && test -f /etc/apt/sources.list.d/kernova.sources; then cp /etc/apt/sources.list.d/packages.list /etc/apt/sources.list.d/00-kernova-local.list; fi";};
