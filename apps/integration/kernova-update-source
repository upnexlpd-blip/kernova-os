#!/usr/bin/python3
"""Create a KERNOVA APT source from a separately verified release-key fingerprint."""
import argparse
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from urllib.parse import urlsplit


def source_text(url, key_file, fingerprint):
    parsed = urlsplit(url)
    if (any(ord(c) <= 32 or ord(c) >= 127 or c == "\\" for c in url)
            or parsed.scheme != "https" or not parsed.hostname or parsed.username is not None
            or parsed.query or parsed.fragment):
        raise ValueError("Use the HTTPS repository root URL without credentials, spaces, query or fragment.")
    fingerprint = fingerprint.upper()
    if not re.fullmatch(r"(?:[A-F0-9]{40}|[A-F0-9]{64})", fingerprint):
        raise ValueError("Supply the full primary-key fingerprint from an independent channel.")
    with tempfile.TemporaryDirectory() as directory:
        gpg = ["gpg", "--no-options", "--batch", "--no-autostart", "--homedir", directory]
        public_key = Path(key_file).read_bytes()
        info = subprocess.check_output([*gpg, "--with-colons", "--show-keys"], input=public_key)
        records = [row.split(":") for row in info.decode("utf-8", errors="replace").splitlines()]
        records = [row for row in records if row[0] in ("pub", "sub", "sec", "ssb", "fpr")]
        keys = [records[i + 1][9] for i, row in enumerate(records[:-1])
                if row[0] == "pub" and records[i + 1][0] == "fpr"]
        if keys != [fingerprint] or any(row[0] in ("sec", "ssb") for row in records):
            raise ValueError("The file must contain exactly the expected public primary key.")
        subprocess.run([*gpg, "--import-options", "import-minimal", "--import"], input=public_key, check=True)
        armor = subprocess.check_output([*gpg, "--armor", "--export-options", "export-minimal",
                                         "--export", fingerprint]).decode("ascii").splitlines()
        if not armor or armor[0] != "-----BEGIN PGP PUBLIC KEY BLOCK-----":
            raise ValueError("Could not export the verified public key.")
    embedded = "\n".join(" " + (line or ".") for line in armor)
    return (f"Types: deb\nURIs: {url.rstrip('/')}\nSuites: kernova-trixie\n"
            f"Components: main\nArchitectures: amd64\nSigned-By:\n{embedded}\n")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("url")
    parser.add_argument("public_key", type=Path)
    parser.add_argument("fingerprint")
    parser.add_argument("output", type=Path, help="a new .sources file")
    args = parser.parse_args()
    if args.output.suffix != ".sources":
        parser.error("The output file must end in .sources")
    try:
        stanza = source_text(args.url, args.public_key, args.fingerprint)
        with args.output.open("x", encoding="ascii", newline="\n") as output:
            output.write(stanza)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"{error}\n")


if __name__ == "__main__":
    main()
